# Supabase Configuration
# Retrieve these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Application URL (for OAuth redirect callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-Side Supabase Service Role Key (NEVER expose to client)
# Used by /api/slack/events and /api/slack/followup to securely access data
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Slack Integration Credentials (Server-side only)
# Retrieve from https://api.slack.com/apps -> Your App
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=https://your-domain.com/api/slack/callback
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Follow-up Automation Cron Secret
# Protects GET /api/slack/followup?secret=...
CRON_SECRET=your-cron-secret-token

# ==========================================
# Phase 3: GitHub App & Evidence Intelligence
# ==========================================
# GitHub App Configuration (Server-side only, NEVER expose to client)
# Create a GitHub App at https://github.com/settings/apps/new
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=your-github-app-slug
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
# Optional fallback for direct repository synchronization or local dev
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_personal_access_token

# ==========================================
# Phase 1 & 3: Universal Gemini Foundation
# ==========================================
# Google Gemini API Key for repository intelligence, project context, and task routing
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# Handoff 1.5: Plan & Resource Limits
# ==========================================
# Server-side maximum workspaces a user can create on the starter free tier (default: 1)
TASKPILOT_MAX_WORKSPACES_PER_USER=1

# Server-side maximum projects allowed per workspace on the starter free tier (default: 5)
TASKPILOT_MAX_PROJECTS_PER_WORKSPACE=5

# ==========================================
# Razorpay Commercial Monetization (INR)
# ==========================================
# Client-accessible Razorpay Key ID (for Razorpay Checkout modal)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Server-Side Razorpay Key Secret (NEVER expose to client)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Server-Side Razorpay Webhook Secret (for verifying x-razorpay-signature)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret



