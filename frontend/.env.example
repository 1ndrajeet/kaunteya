# Supabase Configuration
# Retrieve these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Application URL (for OAuth redirect callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-Side Supabase Service Role Key (NEVER expose to client)
# Used by /api/slack/events and /api/slack/followup to securely access data
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Slack Integration Credentials (Server-side only)
# Retrieve from https://api.slack.com/apps -> Your App
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Follow-up Automation Cron Secret
# Protects GET /api/slack/followup?secret=...
CRON_SECRET=your-cron-secret-token
